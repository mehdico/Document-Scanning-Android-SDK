<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ZdcTextView12sp">
        <item name="android:textSize">@dimen/zdc_text_size_small</item>
    </style>

    <style name="ZdcTextView14sp">
        <item name="android:textSize">@dimen/zdc_text_size_medium_small</item>
    </style>

    <style name="ZdcTextView18sp">
        <item name="android:textSize">@dimen/zdc_text_size_big</item>
    </style>

    <style name="ZdcTextView14sp.White">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="ZdcTextView18sp.White">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="ActivityTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <!-- Opt-out edge-to-edge (API 35 only).
             Suppress warning since lower APIs just ignore it -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement"  tools:ignore="NewApi">true</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

</resources>