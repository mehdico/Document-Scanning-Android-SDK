<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Opt-out edge-to-edge (API 35 only).
             Suppress warning since lower APIs just ignore it -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:ignore="NewApi">true</item>
    </style>

    <style name="AppCompatNoActionBarOptOutEdgeToEdge" parent="Theme.AppCompat.NoActionBar">
        <!-- Opt-out edge-to-edge (API 35 only).
             Suppress warning since lower APIs just ignore it -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:ignore="NewApi">true</item>
    </style>

</resources>